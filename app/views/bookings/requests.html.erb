<h1>Booking requests</h1>

<% if @bookings.any? %>
  <ul class="booking-list">
    <% @bookings.each do |booking| %>
      <li>
        <strong><%= booking.renter.name %></strong> wants
        <strong><%= link_to booking.listing.title, booking.listing %></strong><br>
        <%= booking.start_on %> → <%= booking.end_on %>
        · <%= money(booking.subtotal_cents, booking.currency) %>
        · <strong><%= booking.status.humanize %></strong>

        <% if booking.requested? %>
          <%= button_to "Approve", approve_booking_path(booking), method: :patch %>
          <%= button_to "Decline", decline_booking_path(booking), method: :patch %>
        <% elsif booking.approved? %>
          <%= button_to "Mark picked up", pickup_booking_path(booking), method: :patch %>
        <% elsif booking.active? %>
          <%= button_to "Mark returned", dropoff_booking_path(booking), method: :patch %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No requests yet.</p>
<% end %>
